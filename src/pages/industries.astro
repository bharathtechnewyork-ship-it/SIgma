---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="Industries"
  description="Precision-engineered components for industrial gas turbines and power generation, aerospace, and oil & gas."
>
  <PageHero
    eyebrow="Industries"
    title="Built for demanding sectors"
    description="Programs where precision, materials capability, and process control are non-negotiable."
  />

  <section class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
    <div class="divide-y divide-graphite border-y border-graphite">
      {
        [
          {
            title: 'Power generation & industrial gas turbines',
            body: 'Components and spares that support turbine programs—including parts used in overhaul and maintenance cycles. We focus on process-capable manufacturing for critical geometries and materials common to gas turbine applications.',
          },
          {
            title: 'Aerospace',
            body: 'Precision mechanical and electro-mechanical components where dimensional integrity, material pedigree, and repeatable process control matter. From prototype through qualified production volumes suited to aerospace supply chains.',
          },
          {
            title: 'Oil & gas',
            body: 'Engineered components for harsh operating environments. We support design-to-manufacture programs that require specialty materials, validated processes, and reliable delivery for field and OEM applications.',
          },
        ].map((item) => (
          <article class="reveal grid gap-6 py-12 md:grid-cols-[1fr_1.2fr] md:gap-16 md:py-16">
            <h2 class="font-display text-2xl font-semibold tracking-tight text-snow md:text-3xl text-balance">
              {item.title}
            </h2>
            <p class="text-mist leading-relaxed">{item.body}</p>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-16 max-w-xl">
      <p class="text-fog leading-relaxed">
        Not sure which capability set fits your program? Share your drawings and requirements—we will map the right path.
      </p>
      <a
        href="/contact"
        class="cta-btn mt-8 inline-flex"
      >
        Request a quote
      </a>
    </div>
  </section>
</Layout>
