---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { brand } from '../brand';
---

<Layout
  title="Brand Identity"
  description="Sigma Precisions brand identity — logo system, color, typography, and voice guidelines."
>
  <PageHero
    eyebrow="Brand identity"
    title="Sigma Precisions"
    description={`${brand.essence} ${brand.positioning}`}
  />

  <section class="mx-auto max-w-6xl space-y-20 px-5 py-16 md:px-8 md:py-24">
    <!-- Essence -->
    <div class="reveal grid gap-8 border-b border-graphite pb-16 md:grid-cols-[1fr_1.4fr]">
      <h2 class="font-display text-2xl font-semibold text-snow md:text-3xl">Brand essence</h2>
      <div class="space-y-4 text-mist leading-relaxed">
        <p class="text-lg text-fog">{brand.tagline}</p>
        <p>{brand.positioning}</p>
        <p class="font-display text-xl font-semibold text-accent-soft">{brand.essence}</p>
      </div>
    </div>

    <!-- Logo system -->
    <div class="reveal">
      <h2 class="font-display text-2xl font-semibold text-snow md:text-3xl">Logo system</h2>
      <p class="mt-4 max-w-2xl text-mist leading-relaxed">
        The mark combines a precision plate, calibrated crosshair, and Sigma path — engineering accuracy under ownership.
      </p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <figure class="border border-graphite bg-steel/50 p-8">
          <img src="/brand/logo-mark.svg" alt="Primary mark" class="mx-auto h-24 w-24" width="96" height="96" />
          <figcaption class="mt-6 text-center text-xs uppercase tracking-[0.2em] text-mist">Primary mark</figcaption>
          <a href="/brand/logo-mark.svg" download class="mt-3 block text-center text-sm text-accent hover:text-accent-soft">Download SVG</a>
        </figure>
        <figure class="border border-graphite bg-steel/50 p-8">
          <img src="/brand/logo-horizontal.svg" alt="Horizontal lockup" class="mx-auto h-14 w-auto max-w-full" width="280" height="50" />
          <figcaption class="mt-6 text-center text-xs uppercase tracking-[0.2em] text-mist">Horizontal</figcaption>
          <a href="/brand/logo-horizontal.svg" download class="mt-3 block text-center text-sm text-accent hover:text-accent-soft">Download SVG</a>
        </figure>
        <figure class="border border-graphite bg-steel/50 p-8 sm:col-span-2 lg:col-span-1">
          <img src="/brand/logo-stacked.svg" alt="Stacked lockup" class="mx-auto h-28 w-auto" width="160" height="118" />
          <figcaption class="mt-6 text-center text-xs uppercase tracking-[0.2em] text-mist">Stacked</figcaption>
          <a href="/brand/logo-stacked.svg" download class="mt-3 block text-center text-sm text-accent hover:text-accent-soft">Download SVG</a>
        </figure>
      </div>

      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <figure class="border border-graphite bg-ink p-8">
          <img src="/brand/logo-mark-mono-light.svg" alt="Mono light mark" class="mx-auto h-20 w-20" width="80" height="80" />
          <figcaption class="mt-6 text-center text-xs uppercase tracking-[0.2em] text-mist">Mono on dark</figcaption>
          <a href="/brand/logo-mark-mono-light.svg" download class="mt-3 block text-center text-sm text-accent hover:text-accent-soft">Download SVG</a>
        </figure>
        <figure class="border border-graphite bg-snow p-8">
          <img src="/brand/logo-mark-mono-dark.svg" alt="Mono dark mark" class="mx-auto h-20 w-20" width="80" height="80" />
          <figcaption class="mt-6 text-center text-xs uppercase tracking-[0.2em] text-graphite">Mono on light</figcaption>
          <a href="/brand/logo-mark-mono-dark.svg" download class="mt-3 block text-center text-sm text-accent-deep hover:text-accent">Download SVG</a>
        </figure>
      </div>

      <ul class="mt-10 max-w-2xl space-y-2 text-sm text-mist">
        <li>{brand.logo.clearSpace}</li>
        <li>{brand.logo.minSize}</li>
        {brand.logo.misuse.map((rule) => <li>{rule}</li>)}
      </ul>
    </div>

    <!-- Color -->
    <div class="reveal border-t border-graphite pt-16">
      <h2 class="font-display text-2xl font-semibold text-snow md:text-3xl">Color</h2>
      <p class="mt-4 max-w-2xl text-mist">Navy steel for authority. Brass for precision and craft. Cool neutrals for clarity.</p>

      <div class="mt-10 space-y-10">
        {
          [
            { label: 'Primary', swatches: brand.colors.primary },
            { label: 'Accent', swatches: brand.colors.accent },
            { label: 'Neutral', swatches: brand.colors.neutral },
          ].map((group) => (
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">{group.label}</p>
              <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {group.swatches.map((c) => (
                  <div class="overflow-hidden border border-graphite">
                    <div class="h-24" style={`background-color:${c.hex}`} />
                    <div class="bg-slate-deep px-4 py-3">
                      <p class="text-sm font-semibold text-snow">{c.name}</p>
                      <p class="mt-1 font-mono text-xs text-accent-soft">{c.hex}</p>
                      <p class="mt-2 text-xs text-mist">{c.role}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Typography -->
    <div class="reveal border-t border-graphite pt-16">
      <h2 class="font-display text-2xl font-semibold text-snow md:text-3xl">Typography</h2>
      <div class="mt-10 grid gap-12 md:grid-cols-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">Display</p>
          <p class="mt-3 font-display text-4xl font-semibold tracking-tight text-snow md:text-5xl">Syne</p>
          <p class="mt-4 text-sm text-mist">{brand.typography.display.role}</p>
          <p class="mt-2 text-xs text-fog">Weights {brand.typography.display.weights}</p>
          <p class="mt-8 font-display text-2xl font-semibold text-snow">SIGMA PRECISIONS</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">Body</p>
          <p class="mt-3 font-sans text-4xl font-semibold tracking-tight text-snow md:text-5xl">Manrope</p>
          <p class="mt-4 text-sm text-mist">{brand.typography.body.role}</p>
          <p class="mt-2 text-xs text-fog">Weights {brand.typography.body.weights}</p>
          <p class="mt-8 text-base leading-relaxed text-mist">
            Design, prototype, qualify, and manufacture precision-engineered systems and components.
          </p>
        </div>
      </div>
    </div>

    <!-- Voice -->
    <div class="reveal border-t border-graphite pt-16">
      <h2 class="font-display text-2xl font-semibold text-snow md:text-3xl">Voice</h2>
      <ul class="mt-6 flex flex-wrap gap-3">
        {
          brand.voice.tone.map((t) => (
            <li class="border border-graphite px-3 py-1.5 text-sm text-fog">{t}</li>
          ))
        }
      </ul>
      <div class="mt-10 grid gap-10 md:grid-cols-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">Do</p>
          <ul class="mt-4 space-y-3 text-sm text-mist">
            {brand.voice.do.map((item) => (
              <li class="border-l border-accent/50 pl-4">{item}</li>
            ))}
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">Don’t</p>
          <ul class="mt-4 space-y-3 text-sm text-mist">
            {brand.voice.dont.map((item) => (
              <li class="border-l border-graphite pl-4">{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Applications -->
    <div class="reveal border-t border-graphite pt-16">
      <h2 class="font-display text-2xl font-semibold text-snow md:text-3xl">In application</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="relative min-h-56 overflow-hidden border border-graphite bg-ink p-8">
          <img src="/brand/logo-horizontal.svg" alt="" class="h-10 w-auto" width="220" height="40" />
          <p class="mt-10 font-display text-2xl font-semibold text-snow">Request a quote</p>
          <p class="mt-3 text-sm text-mist">CTA + lockup on Ink Navy</p>
          <span class="cta-btn mt-8 inline-flex !px-4 !py-2">Request a quote</span>
        </div>
        <div class="relative min-h-56 overflow-hidden border border-graphite">
          <img src="/images/facility.jpg" alt="" class="absolute inset-0 h-full w-full object-cover opacity-40" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-transparent" />
          <div class="relative flex h-full min-h-56 flex-col justify-end p-8">
            <img src="/brand/logo-mark.svg" alt="" class="h-12 w-12" width="48" height="48" />
            <p class="mt-4 font-display text-xl font-semibold text-snow">On photography</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
